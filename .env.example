# === DATABASE (PostgreSQL) ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret_postgres_pass
POSTGRES_DB=aibot_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === CACHE & BROKER (Redis) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1


# === TELEGRAM PARSER (Telethon / MTProto) ===
# Получить на https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_telethon_string_session

# === TELEGRAM PUBLISHER (Aiogram Bot) ===
# Получить у @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ID вашего целевого канала (например, @my_channel или -1001234567890)
TARGET_CHANNEL_ID=-1001234567890

# === AI INTEGRATION (OpenAI) ===
OPENAI_API_KEY=sk-proj-your_openai_api_key

# === SECURITY LAYER ===
SECRET_KEY=your_super_secret_jwt_key_here
# Единый пароль для доступа/регистрации
SECURITY_PASSWORD=your_secure_unified_password_here
# Статический инвайт-токен для инициализации/настройки через /api/v1/auth/setup
INVITE_TOKEN=your_generated_invite_token_here